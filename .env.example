# ─── База данных ──────────────────────────────────────────────────────────────
# PostgreSQL. Для локальной разработки можно поднять Postgres локально либо
# использовать строку подключения удалённой БД.
DATABASE_URL="postgresql://garage19:garage19@localhost:5432/garage19?schema=public"

# ─── Приложение ───────────────────────────────────────────────────────────────
NODE_ENV="development"
# Публичный адрес сайта (используется в SEO, sitemap, письмах)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Секрет для подписи cookie (сгенерируйте: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
APP_SECRET="change-me-to-a-long-random-string"

# ─── Админка ──────────────────────────────────────────────────────────────────
# Логин/пароль администратора, создаваемого сидером
ADMIN_EMAIL="admin@garage19.ru"
ADMIN_PASSWORD="Garage19!Admin"
ADMIN_NAME="Администратор"

# ─── Доставка (заполняется при подключении) ───────────────────────────────────
# СДЭК
CDEK_ACCOUNT=""
CDEK_SECURE_PASSWORD=""
CDEK_TEST_MODE="true"
# Boxberry
BOXBERRY_TOKEN=""
BOXBERRY_TEST_MODE="true"
# Почта России
RUSSIAN_POST_LOGIN=""
RUSSIAN_POST_PASSWORD=""
RUSSIAN_POST_TOKEN=""
# Имитация расчёта, если ключи не заданы (true — считать по тарифам из БД)
DELIVERY_MOCK="true"

# ─── Оплата (подключается отдельным этапом) ───────────────────────────────────
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
